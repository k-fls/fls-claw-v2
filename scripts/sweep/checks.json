{
  "typecheck": [
    { "cmd": "pnpm run typecheck", "cwd": ".", "missingDeclRe": "error TS(2305|2307|2724):" },
    { "cmd": "tsc -p container/agent-runner/tsconfig.json --noEmit", "cwd": "." }
  ],
  "test": [
    { "cmd": "pnpm test", "cwd": ".", "filter": "pnpm test {files}" },
    { "cmd": "bun test", "cwd": "container/agent-runner", "filter": "bun test {files}" }
  ],
  "testPaths": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts"]
}
